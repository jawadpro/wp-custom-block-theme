{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jd/projects",
	"title": "Projects",
	"category": "jawad",
	"icon": "portfolio",
	"description": "Work items as a horizontal pinned track or a filterable grid.",
	"textdomain": "jawad",
	"attributes": {
		"layout": {
			"type": "string",
			"enum": [
				"track",
				"grid"
			],
			"default": "track"
		},
		"count": {
			"type": "number",
			"default": 6,
			"minimum": 1,
			"maximum": 24
		},
		"featuredOnly": {
			"type": "boolean",
			"default": false
		},
		"filters": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"reusable": false
	},
	"editorScript": "jd-blocks-editor",
	"render": "file:./render.php"
}
