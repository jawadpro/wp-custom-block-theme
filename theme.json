{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"palette": [
				{ "slug": "midnight", "name": "Midnight", "color": "#0A0E1A" },
				{ "slug": "navy", "name": "Navy", "color": "#0F1528" },
				{ "slug": "navy-2", "name": "Navy 2", "color": "#151D36" },
				{ "slug": "navy-3", "name": "Navy 3", "color": "#1A2547" },
				{ "slug": "line", "name": "Line", "color": "#232C4A" },
				{ "slug": "paper", "name": "Paper", "color": "#F2F4FA" },
				{ "slug": "muted", "name": "Muted", "color": "#9AA3BD" },
				{ "slug": "cobalt", "name": "Cobalt", "color": "#3D5AFE" },
				{ "slug": "cobalt-hi", "name": "Cobalt light", "color": "#5B74FF" },
				{ "slug": "mint", "name": "Mint", "color": "#5CF2C8" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1360px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "12px" },
				{ "slug": "30", "name": "S", "size": "24px" },
				{ "slug": "40", "name": "M", "size": "40px" },
				{ "slug": "50", "name": "L", "size": "56px" },
				{ "slug": "60", "name": "XL", "size": "clamp(64px, 8vw, 112px)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(88px, 11vw, 160px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Archivo",
					"fontFamily": "Archivo, 'Arial Narrow', Impact, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-wdth.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Instrument Sans",
					"fontFamily": "'Instrument Sans', 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontWeight": "400 700",
							"fontStretch": "75% 100%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/instrument-sans-wdth.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-400.woff2" ]
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-500.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "13px" },
				{ "slug": "small", "name": "Small", "size": "15px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "clamp(18px, 1.5vw, 21px)" },
				{ "slug": "x-large", "name": "XL", "size": "clamp(26px, 3vw, 40px)" },
				{ "slug": "xx-large", "name": "XXL", "size": "clamp(32px, 4.6vw, 68px)" },
				{ "slug": "display", "name": "Display", "size": "clamp(52px, 8.4vw, 132px)" },
				{ "slug": "hero", "name": "Hero", "size": "clamp(60px, min(11vw, 19vh), 180px)" }
			]
		},
		"custom": {
			"radius": { "sm": "14px", "md": "20px", "lg": "32px", "pill": "999px" },
			"ease": "cubic-bezier(.2,.7,0,1)"
		},
		"border": { "radius": true, "color": true, "width": true, "style": true }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--midnight)",
			"text": "var(--wp--preset--color--paper)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--paper)" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--mint)" } },
				":focus": { "color": { "text": "var(--wp--preset--color--mint)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "0.9" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "24px" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--cobalt)", "text": "#FFFFFF" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "15px", "fontWeight": "600", "lineHeight": "1.2" },
				"border": { "radius": "999px", "width": "0" },
				"spacing": { "padding": { "top": "14px", "right": "24px", "bottom": "14px", "left": "24px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--mint)", "text": "var(--wp--preset--color--midnight)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--mint)", "text": "var(--wp--preset--color--midnight)" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"blocks": {
			"core/paragraph": { "typography": { "lineHeight": "1.6" } },
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--cobalt)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--navy)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "15px" },
				"border": { "radius": "14px", "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" },
				"spacing": { "padding": { "top": "20px", "right": "24px", "bottom": "20px", "left": "24px" } }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } }
		}
	},
	"customTemplates": [
		{ "name": "page-blank", "title": "Page without title", "postTypes": [ "page" ] },
		{ "name": "page-wide", "title": "Wide page with title", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
